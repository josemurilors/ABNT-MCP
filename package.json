{
  "name": "tcc-mcp",
  "version": "0.1.0",
  "description": "MCP server for academic writing assistance (ABNT standards)",
  "scripts": {
    "prepare": "husky",
    "lint:md": "markdownlint-cli2 '**/*.md' '!node_modules/**/*.md' '!**/.venv/**/*.md'",
    "lint:md:fix": "markdownlint-cli2 '**/*.md' '!node_modules/**/*.md' '!**/.venv/**/*.md' --fix",
    "lint:secrets": "gitleaks detect --source . -v --config .gitleaks.toml",
    "verify:gitignore": "./scripts/verify-gitignore.sh",
    "mode:en": "./scripts/set-mode.sh en-first",
    "mode:pt": "./scripts/set-mode.sh pt-br-first"
  },
  "keywords": [
    "mcp",
    "academic-writing",
    "abnt",
    "tcc",
    "brazilian-portuguese"
  ],
  "author": "Jose Murilo <josemurilors@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/josemurilors/mcp-skill-tcc.git"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.2"
  }
}
